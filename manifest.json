{
  "manifest_version": 3,
  "name": "Replyer — Auto Reply IA pour X",
  "version": "0.1.0",
  "description": "Sur x.com, ajoute une icône au-dessus de Grok qui ouvre une sidebar custom pour configurer et générer des réponses IA (OpenAI) à un tweet sélectionné.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*",
    "https://api.openai.com/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "Replyer — ouvrir/fermer la sidebar",
    "default_icon": {
      "16": "src/icon.png",
      "32": "src/icon.png",
      "48": "src/icon.png",
      "128": "src/icon.png"
    }
  },
  "icons": {
    "16": "src/icon.png",
    "32": "src/icon.png",
    "48": "src/icon.png",
    "128": "src/icon.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["src/icon.png"],
      "matches": ["https://x.com/*", "https://twitter.com/*"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["src/content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
